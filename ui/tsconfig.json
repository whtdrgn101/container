{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
    // No per-game `./client` includes: since 2026-07-31 all six games install from npm as compiled
    // `dist/` (with shipped `.d.ts`), so each package typechecks its own client in its own repo and the
    // shell consumes the published types out of `node_modules` like any dependency — exactly as Labyrinth
    // already did. The shell still typechecks its own registry against those types.
  ]
}
