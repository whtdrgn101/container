{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["react"]
  },
  // The engine/module/bot subpaths depend only on `@game-hub/kernel` (+ Fastify/React types), so the
  // package typechecks them itself. The `./client` subpath reaches into the UI shell (`@/lib/api`, the
  // shared board components) and React, so it is typechecked by the UI host instead — see the Track D
  // findings log in ROADMAP.md (the RR precedent: a TS-source game package can't fully typecheck its own
  // client without pulling in the UI's path aliases).
  "include": ["src/engine", "src/module", "src/bot", "vitest.config.ts"]
}
