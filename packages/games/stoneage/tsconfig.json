{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react"]
  },
  // Track D / D2b: the `./client` subpath now depends only on `@game-hub/kernel/client` + `@game-hub/ui-kit`
  // + React — it reaches into `ui/src` nowhere — so the package typechecks **all four** subpaths itself.
  // (The UI host still typechecks it too, which is what proves the board's props line up with the shell.)
  "include": ["src", "vitest.config.ts"]
}
