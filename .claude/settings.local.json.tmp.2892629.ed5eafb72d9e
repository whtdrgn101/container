{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter @game-hub/ui build)",
      "Bash(pnpm audit *)",
      "Bash(pnpm exec *)",
      "Bash(timeout 300 pnpm --filter @game-hub/ui exec playwright test visual.spec.ts --reporter=list)",
      "Bash(pnpm --filter @game-hub/engine typecheck)",
      "Bash(rm -f ui/e2e/visual.spec.ts-snapshots/*-linux.png)",
      "Bash(rm -rf ui/test-results)",
      "Bash(timeout 300 pnpm --filter @game-hub/engine test)",
      "Bash(pnpm -r --if-present exec node -e \"1\")",
      "Bash(rm -rf ui/test-results ui/playwright-report)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test:engine)",
      "Bash(pnpm test:bot)",
      "Bash(pnpm test:backend)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
