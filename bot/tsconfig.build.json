{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src"],
  // bench.ts is the console-printing bench driver (run via tsx, env-gated) — a dev tool, not part of
  // the distributable surface, and the pure bot package deliberately has no Node types to compile it.
  "exclude": ["src/**/*.test.ts", "src/bench.ts"]
}
