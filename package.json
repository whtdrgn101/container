{
  "name": "container-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Digital version of the board game Container — TypeScript monorepo (shared engine + REST API + React UI).",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @container/engine test",
    "test:backend": "pnpm --filter @container/backend test",
    "test:e2e": "pnpm --filter @container/ui test:e2e",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev:backend": "pnpm --filter @container/backend dev",
    "dev:ui": "pnpm --filter @container/ui dev"
  }
}
